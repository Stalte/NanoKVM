#!/bin/sh
#
# NanoKVM hardened build: Wi-Fi is disabled.
#
# The radio would be a second way off the device, so this script replaces the
# stock one and only ever takes the interface down. It keeps the stock name
# because kvm_system and the stock migration copy and call it by that name.

stop_wifi() {
    for d in wpa_supplicant hostapd udhcpd; do
        killall "$d" >/dev/null 2>&1
    done
    [ -e /run/udhcpc.wlan0.pid ] && kill "$(cat /run/udhcpc.wlan0.pid)" >/dev/null 2>&1
    ip link set wlan0 down >/dev/null 2>&1
}

case "$1" in
    start|stop|restart|reload)
        stop_wifi
        echo "wifi disabled (hardened build)"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit 0

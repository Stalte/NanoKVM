#!/bin/sh
#
# NanoKVM hardened build: tailscaled as an unprivileged user.
#
# tailscaled runs as the "tailscale" user (see /kvmapp/hardening/hardening.conf)
# in userspace-networking mode, so it needs no root and no TUN device. That
# user is the only one the firewall lets open connections to the internet.
# The web UI and SSH reach the tailnet through "tailscale serve", which
# /kvmapp/hardening/harden.sh sets up once the device is logged in.

DAEMON="tailscaled"
PIDFILE="/var/run/$DAEMON.pid"
HARDEN_DIR=/kvmapp/hardening
GUARD="$HARDEN_DIR/nanokvm-guard"

. "$HARDEN_DIR/hardening.conf"
[ -f /etc/kvm/hardening.conf ] && . /etc/kvm/hardening.conf
[ -f /boot/hardening.conf ] && . /boot/hardening.conf

[ -x /usr/sbin/$DAEMON ] || { echo "/usr/sbin/$DAEMON not found; run $HARDEN_DIR/harden.sh apply"; exit 1; }
[ -x /usr/bin/tailscale ] || { echo "/usr/bin/tailscale not found; run $HARDEN_DIR/harden.sh apply"; exit 1; }
[ -x "$GUARD" ] || { echo "$GUARD not found"; exit 1; }

start() {
    if [ -f /etc/kvm/GOMEMLIMIT ]; then
        limit=$(cat /etc/kvm/GOMEMLIMIT)
        export GOMEMLIMIT="${limit}MiB"
    else
        export GOMEMLIMIT=512MiB
    fi
    # Never upload logs to log.tailscale.io.
    export TS_NO_LOGS_NO_SUPPORT=true

    mkdir -p /var/lib/tailscale /var/run/tailscale
    chown -R "$TS_UID:$TS_UID" /var/lib/tailscale /var/run/tailscale
    chmod 700 /var/lib/tailscale

    # The clock is set by harden.sh's keeper as soon as the network is up;
    # tailscaled retries the control server on its own until then.

    if pidof "$DAEMON" >/dev/null 2>&1; then
        echo "$DAEMON already running"
        return 0
    fi

    printf "Starting %s as %s: " "$DAEMON" "$TS_USER"
    start-stop-daemon -S -b -m -q -p "$PIDFILE" -x "$GUARD" -- \
        run-as "$TS_USER" -- /usr/sbin/$DAEMON \
        --tun=userspace-networking \
        --state=/var/lib/tailscale/tailscaled.state \
        --statedir=/var/lib/tailscale \
        --socket=/var/run/tailscale/tailscaled.sock \
        --port="$TS_PORT" \
        --no-logs-no-support
    if [ $? = 0 ]; then
        echo "OK"
        # The device manages its own DNS and is never a router for the tailnet.
        (
            sleep 5
            tailscale set --accept-dns=false --accept-routes=false --advertise-exit-node=false --ssh=false
            "$HARDEN_DIR/harden.sh" serve
        ) </dev/null >/dev/null 2>&1 &
    else
        echo "FAIL"
    fi
}

stop() {
    printf "Stopping %s: " "$DAEMON"
    start-stop-daemon -K -q -p "$PIDFILE"
    [ $? = 0 ] && { echo "OK"; rm -f "$PIDFILE"; } || echo "FAIL"
    killall "$DAEMON" >/dev/null 2>&1
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop
        sleep 1
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit 0
